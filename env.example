# Copy this file to `.env` and fill in your values. Never commit `.env`.

# ------------------------------------------------------------------
# REQUIRED: Google Gemini
# ------------------------------------------------------------------
# One key, or several separated by commas. A random key is used per request
# so no single key's quota gets used up.
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Model ID used for analysis (default shown). Change it if your keys don't support it.
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# REQUIRED: AWS S3 scan receipts
# ------------------------------------------------------------------
# Every successful scan saves a JSON receipt to receipts/ in this bucket.
# The IAM user only needs s3:PutObject on arn:aws:s3:::YOUR-BUCKET/receipts/*
MY_BUCKET_NAME=your-bucket-name
MY_ACCESS_KEY=your_aws_access_key_id
MY_SECRET_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# ------------------------------------------------------------------
# OPTIONAL: GitHub
# ------------------------------------------------------------------
# Personal access token. Raises the API rate limit and allows private repos.
# Create at https://github.com/settings/tokens (read-only access is enough).
GITHUB_TOKEN=
